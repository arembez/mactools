{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Wails: Debug Production Build",
            "type": "go",
            "request": "launch",
            "mode": "exec",                   
            "program": "${workspaceFolder}/build/bin/mactools.app/Contents/MacOS/mactools",
            "cwd": "${workspaceFolder}",
            "env": {
                "CGO_ENABLED": "1"
            },
            "preLaunchTask": "wails build -debug"
        }
    ]
}